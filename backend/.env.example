# Backend environment variables — copy to .env and fill in real values
# NEVER commit .env to git

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mutunerent?retryWrites=true&w=majority

# ─── Auth & Security ─────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_byte_hex_key_here
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=***REDACTED***

# ─── M-Pesa Daraja (Safaricom) ────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://mutunerent-api.onrender.com/api/v1/payments/callback
MPESA_C2B_CONFIRMATION_URL=https://mutunerent-api.onrender.com/api/v1/payments/c2b/confirm
MPESA_C2B_VALIDATION_URL=https://mutunerent-api.onrender.com/api/v1/payments/c2b/validate
MPESA_ENV=sandbox

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
# Variable names MUST match sms.js: process.env.AT_API_KEY / AT_USERNAME / AT_FROM
AT_API_KEY=atsk_your_api_key
AT_USERNAME=sandbox
AT_FROM=MutuneRent
AT_USSD_SHORTCODE=*384*9988#

# ─── Cloudflare R2 Object Storage (S3-compatible) ────────────────────────────
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET=mutune-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── Plus Codes / Open Location Code ─────────────────────────────────────────
PLUS_CODE_REGION=KE

# ─── Groq Cloud AI (Phase 3 - Obsolete) ──────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.3

# ─── Kimi AI (Phase 3 Upgrade) ────────────────────────────────────────────────
KIMI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_API_URL=https://api.moonshot.ai/v1/chat/completions

# ─── Resend Email (Phase 3) ───────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notices@mutune.co.ke

# ─── Notice PDF Storage (uses same R2 bucket as images) ──────────────────────
NOTICE_PDF_PREFIX=notices/

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
SENTRY_DSN=https://your-dsn@o12345.ingest.de.sentry.io/12345

# ─── Admin ───────────────────────────────────────────────────────────────────
# Required in production — no default fallback. Set a strong, unique password.
ADMIN_HARDCODED_PASSWORD=
ADMIN_PASSWORD=your_admin_password_here

# Optional — only used if you later switch Task 1 from static CC0 models to
# AI-generated per-property models. Not required for the app to function.
# Get keys at https://www.meshy.ai/ (has a free tier) or https://platform.tripo3d.ai/
MESHY_API_KEY=
TRIPO3D_API_KEY=



# ─── Kyanda Utility Aggregator (KPLC & Water) ──────────────────────────────────
# Required for live meter validation, postpaid bill query, and prepaid token vending
KYANDA_API_KEY=your_kyanda_api_key
KYANDA_API_URL=https://api.kyanda.africa/v1
KYANDA_MERCHANT_ID=your_kyanda_merchant_id

# ─── KRA eTIMS Tax Compliance ──────────────────────────────────────────────────
# Required for electronic invoice transmission — no silent fallbacks
KRA_ETIMS_PIN=P05xxxxxxxxZ
KRA_ETIMS_DEVICE_SERIAL=KRA-CU-xxxxxxxx
KRA_ETIMS_CLIENT_SECRET=your_etims_client_secret
KRA_ETIMS_BASE_URL=https://etims.kra.go.ke/etims-api/v1
KRA_ETIMS_ENV=sandbox

# ─── M-Pesa Daraja B2C (Bulk Disbursement) ────────────────────────────────────
DARAJA_CONSUMER_KEY=your_daraja_b2c_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_b2c_consumer_secret
DARAJA_B2C_SHORTCODE=600986
DARAJA_B2C_INITIATOR=testapi
DARAJA_B2C_PASSWORD=your_b2c_initiator_password
DARAJA_ENV=sandbox

# ─── IntaSend Multi-Bank Payment Aggregator (Phase 3) ─────────────────────────
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxxxxxxxxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecKey_test_xxxxxxxxxxxxxxxxxxxxxxxx
INTASEND_ENVIRONMENT=sandbox

# ─── M-Pesa Reversals & Account Balance Query (Phase 3) ───────────────────────
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_mpesa_initiator_security_credential

# --- 3D Generation -----------------------------------------------------------
BLENDER_PATH=
MODAL_3D_SPLAT_WEBHOOK_URL=
MODAL_BLENDER_WEBHOOK_URL=https://your-modal-webhook-url
MODAL_WEBHOOK_SECRET=your_modal_webhook_secret
