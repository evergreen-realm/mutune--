# Backend environment variables — copy to .env and fill in real values
# NEVER commit .env to git

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mutunerent?retryWrites=true&w=majority

# ─── Clerk Authentication ─────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── M-Pesa Daraja (Safaricom) ────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-domain.onrender.com/api/v1/payments/callback
MPESA_C2B_CONFIRMATION_URL=https://your-domain.onrender.com/api/v1/payments/c2b/confirm
MPESA_C2B_VALIDATION_URL=https://your-domain.onrender.com/api/v1/payments/c2b/validate
MPESA_ENV=sandbox

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
# Variable names MUST match sms.js: process.env.AT_API_KEY / AT_USERNAME / AT_FROM
AT_API_KEY=atsk_your_api_key
AT_USERNAME=sandbox
AT_FROM=MutuneRent
AFRICAS_TALKING_API_KEY=your_at_api_key
AFRICAS_TALKING_USERNAME=your_at_username
AFRICAS_TALKING_SMS_FROM=MutuneRent

# ─── Cloudflare R2 Object Storage (S3-compatible) ────────────────────────────
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET=mutune-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── Plus Codes / Open Location Code ─────────────────────────────────────────
PLUS_CODE_REGION=KE

# ─── Groq Cloud AI (Phase 3 - Obsolete) ──────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.3

# ─── Kimi AI (Phase 3 Upgrade) ────────────────────────────────────────────────
KIMI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_API_URL=https://api.moonshot.ai/v1/chat/completions

# ─── Resend Email (Phase 3) ───────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notices@mutune.co.ke

# ─── Notice PDF Storage (uses same R2 bucket as images) ──────────────────────
NOTICE_PDF_PREFIX=notices/

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
SENTRY_DSN=https://your-dsn@o12345.ingest.de.sentry.io/12345

# ─── Admin ───────────────────────────────────────────────────────────────────
# Required in production — no default fallback. Set a strong, unique password.
ADMIN_HARDCODED_PASSWORD=

